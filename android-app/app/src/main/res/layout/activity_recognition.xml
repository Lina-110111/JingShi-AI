<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8F5">

    <!-- 页面主体 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- 顶部导航栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#2E7D32"
                    android:textSize="34sp"
                    android:fontFamily="sans"
                    android:contentDescription="返回"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI 智能识别"
                        android:textColor="#26352B"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SMART RECOGNITION"
                        android:textColor="#82948A"
                        android:textSize="8sp"
                        android:letterSpacing="0.12"/>

                </LinearLayout>

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="♻"
                    android:textColor="#2E7D32"
                    android:textSize="27sp"/>

            </LinearLayout>

            <!-- 页面说明：删除重复的大标题，保留原副标题 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="拍摄或上传垃圾图片，让 AI 帮你快速识别分类"
                android:textColor="#718477"
                android:textSize="13sp"/>

            <!-- 上传区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_recognition_panel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="上传识别图片"
                        android:textColor="#26352B"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IMAGE UPLOAD"
                        android:textColor="#5B8B63"
                        android:textSize="9sp"
                        android:letterSpacing="0.08"/>

                </LinearLayout>

                <!-- 图片预览 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_recognition_result">

                    <ImageView
                        android:id="@+id/ivPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:contentDescription="待识别图片"/>

                    <LinearLayout
                        android:id="@+id/layoutPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▧"
                            android:textColor="#2E7D32"
                            android:textSize="48sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="选择一张垃圾图片"
                            android:textColor="#26352B"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="支持 JPG、PNG 等常见图片格式"
                            android:textColor="#82948A"
                            android:textSize="11sp"/>

                    </LinearLayout>

                </FrameLayout>

                <!-- 图片操作按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCamera"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_recognition_primary"
                        android:backgroundTint="@null"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="📷  拍照"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null"/>

                    <Button
                        android:id="@+id/btnGallery"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_recognition_outline"
                        android:backgroundTint="@null"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="▧  相册选择"
                        android:textAllCaps="false"
                        android:textColor="#2E7D32"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null"/>

                </LinearLayout>

            </LinearLayout>

            <!-- 开始识别 -->
            <Button
                android:id="@+id/btnStartRecognition"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_recognition_gradient"
                android:backgroundTint="@null"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="✦  开始智能识别"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:enabled="false"
                android:alpha="0.55"
                android:stateListAnimator="@null"/>

            <!-- 识别结果卡片 -->
            <LinearLayout
                android:id="@+id/layoutResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_recognition_result"
                android:visibility="gone">

                <!-- 标题 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="识别结果"
                        android:textColor="#26352B"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_recognition_panel"
                        android:paddingHorizontal="11dp"
                        android:paddingVertical="6dp"
                        android:text="演示结果"
                        android:textColor="#2E7D32"
                        android:textSize="10sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- 识别物品 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="识别物品"
                    android:textColor="#82948A"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvObjectName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="塑料瓶"
                    android:textColor="#26352B"
                    android:textSize="23sp"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="17dp"
                    android:background="#E8EEE9"/>

                <!-- 垃圾类别 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="所属垃圾类别"
                    android:textColor="#82948A"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_recognition_panel"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="可回收物"
                    android:textColor="#2E7D32"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <!-- 置信度 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="识别置信度"
                        android:textColor="#82948A"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/tvConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="96.8%"
                        android:textColor="#2E7D32"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- 投放建议 -->
                <TextView
                    android:id="@+id/tvSuggestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:background="#F2F7F2"
                    android:padding="13dp"
                    android:lineSpacingExtra="5dp"
                    android:text="投放建议：清空瓶内液体，简单冲洗后投入可回收物收集容器。"
                    android:textColor="#52645A"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- 页面底部标语 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="净识AI · 让垃圾分类更简单"
                android:textColor="#9AAA9D"
                android:textSize="11sp"/>

        </LinearLayout>

    </ScrollView>

    <!-- 底部导航栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- 首页 -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_home"
                android:contentDescription="首页"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="首页"
                android:textSize="11sp"
                android:textColor="#78909C"/>

        </LinearLayout>

        <!-- 识别 -->
        <LinearLayout
            android:id="@+id/navRecognition"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_scan"
                android:contentDescription="识别"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="识别"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"/>

        </LinearLayout>

        <!-- 游戏 -->
        <LinearLayout
            android:id="@+id/navGame"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_game"
                android:contentDescription="游戏"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="游戏"
                android:textSize="11sp"
                android:textColor="#78909C"/>

        </LinearLayout>

        <!-- 我的 -->
        <LinearLayout
            android:id="@+id/navMine"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_mine"
                android:contentDescription="我的"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的"
                android:textSize="11sp"
                android:textColor="#78909C"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
