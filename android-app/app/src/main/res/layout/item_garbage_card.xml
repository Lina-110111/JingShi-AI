<?xml version="1.0" encoding="utf-8"?>
<!-- 单张垃圾卡片：emoji 图标 + 名称，长按可拖拽 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="82dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="6dp"
    android:background="@drawable/game_bg_card"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <!-- 垃圾图标：emoji 字形，垫一层浅绿圆角块 -->
    <TextView
        android:id="@+id/tvGarbageIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/game_bg_thumb"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textSize="26sp" />

    <!-- 垃圾名称 -->
    <TextView
        android:id="@+id/tvGarbageName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:minHeight="30dp"
        android:textColor="@color/game_text_title"
        android:textSize="12sp" />
</LinearLayout>
